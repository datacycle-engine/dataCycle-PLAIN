**/.git/
**/.codegraph/
**/.bundle/
**/log/*
**/*.log
**/public/downloads/*
**/public/uploads
**/public/assets
**/private/import
**/lib/assets
**/tmp/
**/node_modules/
**/.idea
**/db/backups
# `.env*`, not just `.env`: CI writes the production environment into the build context
# as .env.production, and dotenv-rails - ungrouped in GemfileCore, so installed in the
# production image too - loads whatever lands at /app/.env.production.
**/.env*
**/cache/

# coverage output and CI config - never needed inside the image.
# `test/` is deliberately NOT excluded: the Dockerfile's `test` stage is what CI runs
# dc:validate and the Minitest suite from, so excluding it would break those jobs.
# Nothing under test/ is loaded at runtime, so it costs only image size.
**/spec/
**/coverage/
**/.github/
