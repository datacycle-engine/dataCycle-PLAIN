.DS_Store
.idea/
.bundle/
node_modules/
**/log/
*.log
tmp/
.env
.tool-versions
public/**/*
# error pages and robots.txt come from dc:upgrade and are served straight out of
# the image, so they have to be in the build context
!public/*.html
!public/robots.txt
private/
coverage/
cache/
docker/hist
**/db/backups
lib/assets
compose.overrides.yaml
var/
.irb-history
.codegraph/
# codegraph's built-in defaults skip vendor/ even though our gems are tracked
!vendor/
