FROM ruby:3.3-slim-trixie

ARG POSTGRES_VERSION=16

ENV DEBIAN_FRONTEND noninteractive
ENV LANG C.UTF-8
ENV TZ=Europe/Vienna
ENV POSTGRES_VERSION=$POSTGRES_VERSION

RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y build-essential locales wget links curl gnupg2 rsync bc git git-core apt-transport-https libxml2 libxml2-dev libcurl4-openssl-dev gawk libreadline6-dev libyaml-dev autoconf libgdbm-dev libncurses5-dev automake libtool bison libffi-dev zlib1g-dev openssl tzdata xvfb libgtk2.0-0 libnotify-dev libnss3 libxss1 libasound2 libgeos-dev libproj-dev nano ghostscript ffmpeg libtag-dev libavformat-dev libmpg123-dev libsamplerate-dev libsndfile-dev cimg-dev libavcodec-dev libswscale-dev openssh-client ca-certificates less mupdf mupdf-tools vim libvips42 webp \
  && update-ca-certificates

RUN curl -sL https://deb.nodesource.com/setup_22.x | bash -
RUN apt-get install -y nodejs build-essential
RUN npm install -g pnpm@10

# PostgreSQL
RUN install -d /usr/share/postgresql-common/pgdg
RUN curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc
RUN . /etc/os-release && sh -c "echo 'deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $VERSION_CODENAME-pgdg main' > /etc/apt/sources.list.d/pgdg.list"
RUN apt-get update
RUN apt-get install -y libpq-dev postgresql-$POSTGRES_VERSION postgresql-client-$POSTGRES_VERSION

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get autoremove -y --purge \
  && apt-get autoclean

WORKDIR /var/app

RUN useradd --create-home ruby \
  && chown -R ruby:ruby /var/app

ENV PATH="${PATH}:/home/ruby/.local/bin" \
    USER="ruby"

USER ruby

RUN mkdir -p /var/app/vendor/gems/data-cycle-core/
RUN mkdir -p /var/app/vendor/gems/datacycle-schema-common/

RUN gem install bundler

COPY --chown=ruby:ruby Gemfile* /var/app/
COPY vendor/gems/data-cycle-core/GemfileCore /var/app/vendor/gems/data-cycle-core/
COPY vendor/gems/data-cycle-core/data_cycle_core.gemspec /var/app/vendor/gems/data-cycle-core
COPY vendor/gems/data-cycle-core/GEM_VERSION /var/app/vendor/gems/data-cycle-core
COPY vendor/gems/datacycle-schema-common/datacycle-schema-common.gemspec /var/app/vendor/gems/datacycle-schema-common
COPY vendor/gems/datacycle-schema-common/GEM_VERSION /var/app/vendor/gems/datacycle-schema-common/

RUN bundle install

COPY --chown=ruby:ruby  package.json /var/app
# COPY --chown=ruby:ruby pnpm-lock.yaml /var/app
COPY --chown=ruby:ruby vendor/gems/data-cycle-core/package.json /var/app/vendor/gems/data-cycle-core
COPY --chown=ruby:ruby vendor/gems/data-cycle-core/dev_dependencies/package.json /var/app/vendor/gems/data-cycle-core/dev_dependencies/.

RUN pnpm i

# COPY --chown=ruby:ruby . .

ENTRYPOINT ["/var/app/docker/web/bin/entrypoint.sh"]

CMD ["bash"]
